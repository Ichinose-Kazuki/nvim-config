{ ... }:
{
  # +/* レジスタを無名レジスタに割り当てる。y/p がシステムクリップボードで読み書きされる。
  # 下の globals.clipboard でバックエンドを OSC 52 に固定するため、外部クリップボード
  # ツールが無いこの環境で初めて真に機能する。
  clipboard.register = "unnamedplus";

  # +/* レジスタのクリップボードプロバイダを OSC 52 に強制する。tmux は OSC 52 の
  # 自動検出を抑制するため、明示的に固定しないと tmux 内でバックエンドが選ばれない。
  # 端末エミュレータのクリップボード（Ctrl+C/V 相当）へ tmux の有無を問わず一貫して繋がる。
  globals.clipboard = "osc52";
}
